# Copy to .env and fill in. Every variable below is read by
# backend/config/settings.py. The file lives at the repository root; the
# backend loads it from there.

# --- Required in all environments -----------------------------------------

# Postgres connection string.
DATABASE_URL=postgres://localhost:5432/secondchair

# --- Required in production ------------------------------------------------

# Django cryptographic signing key. Production refuses to start without it.
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated hostnames Django will serve. On Render this may be left
# empty, because RENDER_EXTERNAL_HOSTNAME is appended automatically.
ALLOWED_HOSTS=

# Comma-separated origins allowed to call the API from a browser, e.g.
# https://corydegarmo.com. When DEBUG is on and this is empty, Vite's dev
# server (:5173) and preview server (:4173) are allowed.
CORS_ALLOWED_ORIGINS=

# Claude API credential. The interview endpoint returns a 503 with a
# "email Cory instead" message if this is missing.
ANTHROPIC_API_KEY=

# --- Optional --------------------------------------------------------------

# Never enable in production.
DEBUG=1

# Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Answer length cap and request timeout for the model call.
ANTHROPIC_MAX_TOKENS=600
ANTHROPIC_TIMEOUT_SECONDS=45

# Address shown to visitors when the agent cannot answer (rate limit,
# upstream error). Also the address in the site footer.
CONTACT_EMAIL=degarmo@gmail.com

# Absolute path override for the knowledge base. Defaults to
# backend/kb/KNOWLEDGE_BASE.md.
KNOWLEDGE_BASE_PATH=

# manage.py, wsgi.py and asgi.py all default to this; set it only to override.
DJANGO_SETTINGS_MODULE=config.settings

# --- Spoken answers (ElevenLabs), optional --------------------------------
#
# With no key or no voice id, the site never offers to speak an answer: the
# play button simply does not appear. Nothing else changes.
#
# List the voices on your account and pick one:
#   cd backend && python manage.py list_voices
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Defaults shown; override only if you have a reason.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=30

# Longest answer that will be sent for synthesis, and how long the audio is
# cached so replays cost nothing.
SPEECH_MAX_CHARS=3000
SPEECH_CACHE_SECONDS=604800
