# Copy to .env and fill in. Every variable below is read by
# secondchair/settings/base.py.

# --- Required in all environments -----------------------------------------

# Postgres connection string.
DATABASE_URL=postgres://localhost:5432/secondchair

# --- Required in production ------------------------------------------------

# Django cryptographic signing key. Production refuses to start without it.
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated hostnames Django will serve. On Render this may be left
# empty, because RENDER_EXTERNAL_HOSTNAME is appended automatically.
ALLOWED_HOSTS=

# --- Optional --------------------------------------------------------------

# Never enable in production.
DEBUG=1

# Claude API credential, used for extraction and answering.
ANTHROPIC_API_KEY=

# Set explicitly to override the default for the entrypoint in use:
# manage.py defaults to secondchair.settings.local,
# wsgi.py/asgi.py default to secondchair.settings.production.
DJANGO_SETTINGS_MODULE=secondchair.settings.local
